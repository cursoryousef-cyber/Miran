/// طاقة استيعابية دقيقة يحدّدها المستشفى نفسه — لا يجوز للتجمع تعديلها مباشرة.
/// scopeId/specialtyCode/gender/trainingPeriod تستخدم '' (وليس NULL) كقيمة
/// "أي/غير محدد" حتى يعمل قيد @@unique بشكل صحيح (Postgres يعامل NULL كقيم
/// متمايزة دائماً، فلا يمنع التكرار لو كانت هذه الحقول nullable).
model CapacityAllocation {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  /// 'hospital' | 'department' | 'specialty' | 'trainer' | 'supervisor' | 'program'
  scopeType      String    @map("scope_type") @db.VarChar(20)
  /// معرف القسم/المدرب/المشرف حسب scopeType، أو '' لسعة المستشفى الكلية
  scopeId        String    @default("") @map("scope_id") @db.VarChar(64)
  /// معرف البرنامج التدريبي من الكتالوج الوطني، أو '' لعدم التقييد ببرنامج.
  /// يُستخدم مع scopeType='program' لسعة البرنامج في المستشفى، ومع
  /// scopeType='department'/'trainer' لتقسيم مقاعد البرنامج على الأقسام والمدربين.
  /// نص وليس مفتاحاً خارجياً — اتساقاً مع scopeId ولتفادي دلالات NULL في قيد التفرد.
  programId      String    @default("") @map("program_id") @db.VarChar(64)
  /// رمز التخصص من LookupTable، أو '' لعدم التقييد بتخصص
  specialtyCode  String    @default("") @map("specialty_code") @db.VarChar(100)
  /// 'male' | 'female' أو '' لعدم التقييد بالجنس
  gender         String    @default("") @db.VarChar(10)
  /// فترة التدريب (عادة academicYear الدفعة)، أو '' لعدم التقييد بفترة
  trainingPeriod String    @default("") @map("training_period") @db.VarChar(50)
  /// بداية فترة التدريب — لربط السعة بفترات زمنية محددة
  trainingStartDate DateTime? @map("training_start_date") @db.Date
  /// نهاية فترة التدريب
  trainingEndDate   DateTime? @map("training_end_date") @db.Date
  totalCapacity  Int       @default(0) @map("total_capacity")
  notes          String?   @db.Text
  createdById    String?   @map("created_by") @db.Uuid
  updatedById    String?   @map("updated_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, scopeType, scopeId, programId, specialtyCode, gender, trainingPeriod])
  @@index([organizationId, scopeType])
  @@index([organizationId, programId])
  @@index([trainingStartDate, trainingEndDate])
  @@map("capacity_allocations")
}

/// تأهيل المدرب للبرامج التدريبية — علاقة متعدد إلى متعدد
/// المدرب لا يشرف إلا على البرامج المُسندة إليه (قيد صارم في محرك التوزيع).
model TrainerProgram {
  id               String   @id @default(uuid()) @db.Uuid
