  verifiedById     String?   @map("verified_by") @db.Uuid
  verifiedAt       DateTime? @map("verified_at") @db.Timestamptz

  objective      Objective      @relation(fields: [objectiveId], references: [id])
  traineeProfile TraineeProfile @relation(fields: [traineeProfileId], references: [id])
  rotation       Rotation       @relation(fields: [rotationId], references: [id])
  verifiedBy     UserAccount?   @relation("ObjectiveVerifier", fields: [verifiedById], references: [id])

  @@unique([objectiveId, traineeProfileId, rotationId])
  @@map("objective_progress")
}

model ImprovementPlan {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  traineeProfileId String   @map("trainee_profile_id") @db.Uuid
  triggerReason    String   @map("trigger_reason") @db.Text
  goals            Json     @default("[]") @db.JsonB
  startDate        DateTime @map("start_date") @db.Date
  endDate          DateTime @map("end_date") @db.Date
  status           String   @default("active") @db.VarChar(20)
  progress         Decimal  @default(0) @db.Decimal(5, 2)
  supervisorId     String?  @map("supervisor_id") @db.Uuid
  createdById      String?  @map("created_by") @db.Uuid
  updatedById      String?  @map("updated_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization   Organization   @relation(fields: [organizationId], references: [id])
  traineeProfile TraineeProfile @relation(fields: [traineeProfileId], references: [id])
  supervisor     UserAccount?   @relation("PlanSupervisor", fields: [supervisorId], references: [id])
  createdBy      UserAccount?   @relation("PlanCreator", fields: [createdById], references: [id])

  @@map("improvement_plans")
}

model ClinicalPrivilege {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  departmentId   String   @map("department_id") @db.Uuid
  traineeLevel   String   @map("trainee_level") @db.VarChar(30)
  titleAr        String   @map("title_ar") @db.VarChar(300)
  titleEn        String?  @map("title_en") @db.VarChar(300)
  privilegeLevel String   @map("privilege_level") @db.VarChar(20)
  sortOrder      Int      @default(0) @map("sort_order")
  createdById    String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  department   Department   @relation(fields: [departmentId], references: [id])

  @@map("clinical_privileges")
}

model DepartmentCommonMistake {
  id            String  @id @default(uuid()) @db.Uuid
  departmentId  String  @map("department_id") @db.Uuid
  titleAr       String  @map("title_ar") @db.VarChar(300)
  titleEn       String? @map("title_en") @db.VarChar(300)
  preventionTip String? @map("prevention_tip") @db.Text
  sortOrder     Int     @default(0) @map("sort_order")

  department Department @relation(fields: [departmentId], references: [id])

  @@map("department_common_mistakes")
}

model DashboardSnapshot {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  dashboardType  String   @map("dashboard_type") @db.VarChar(50)
  data           Json     @db.JsonB
  snapshotDate   DateTime @map("snapshot_date") @db.Date
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("dashboard_snapshots")
}

model Task {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  assignedToId   String    @map("assigned_to") @db.Uuid
  assignedById   String?   @map("assigned_by") @db.Uuid
  titleAr        String    @map("title_ar") @db.VarChar(300)
  description    String?   @db.Text
  dueDate        DateTime? @map("due_date") @db.Timestamptz
  status         String    @default("pending") @db.VarChar(20)
  priority       String    @default("normal") @db.VarChar(10)
  referenceType  String?   @map("reference_type") @db.VarChar(50)
  referenceId    String?   @map("reference_id") @db.Uuid
  completedAt    DateTime? @map("completed_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  assignedTo   UserAccount  @relation("TaskAssignee", fields: [assignedToId], references: [id])
  assignedBy   UserAccount? @relation("TaskCreator", fields: [assignedById], references: [id])

  @@map("tasks")
}

model Incident {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  reportedById   String    @map("reported_by") @db.Uuid
  incidentType   String    @map("incident_type") @db.VarChar(50)
  description    String    @db.Text
  severity       String    @default("low") @db.VarChar(20)
  status         String    @default("open") @db.VarChar(20)
  resolution     String?   @db.Text
  resolvedById   String?   @map("resolved_by") @db.Uuid
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  reportedBy   UserAccount  @relation("IncidentReporter", fields: [reportedById], references: [id])
  resolvedBy   UserAccount? @relation("IncidentResolver", fields: [resolvedById], references: [id])

  @@map("incidents")
}

// ============================================================================
// 19. MANDATORY DECLARATIONS & ACCEPTANCES
// ============================================================================

/// الإقرارات والتعهدات الوطنية (إقرار الانضمام وإقرار الشؤون الأكاديمية)
model Declaration {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  type           String   @db.VarChar(50) // 'joining', 'academic_affairs', 'ethics'
  titleAr        String   @map("title_ar") @db.VarChar(300)
  titleEn        String?  @map("title_en") @db.VarChar(300)
  contentAr      String   @map("content_ar") @db.Text
  contentEn      String?  @map("content_en") @db.Text
  version        Int      @default(1)
  isActive       Boolean  @default(true) @map("is_active")
  isMandatory    Boolean  @default(true) @map("is_mandatory")
  createdById    String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization            @relation(fields: [organizationId], references: [id])
  acceptances  DeclarationAcceptance[]

  @@map("declarations")
}

/// سجلات الموافقة والتوقيع الرقمي للإقرارات
model DeclarationAcceptance {
  id             String   @id @default(uuid()) @db.Uuid
  declarationId String   @map("declaration_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  version        Int
  acceptedAt     DateTime @default(now()) @map("accepted_at") @db.Timestamptz
  ipAddress      String?  @map("ip_address") @db.VarChar(50)
  deviceInfo     String?  @map("device_info") @db.VarChar(300)

  declaration  Declaration  @relation(fields: [declarationId], references: [id], onDelete: Cascade)
  user         UserAccount  @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([declarationId, userId, version])
  @@map("declaration_acceptances")
}

// ============================================================================
// 20. CLINICAL LOGBOOK & COMPETENCY PORTFOLIO
// ============================================================================

/// مكتبة الإجراءات والمهارات السريرية
model ProcedureCatalog {
  id             String   @id @default(uuid()) @db.Uuid
  code           String   @unique @db.VarChar(50)
  titleAr        String   @map("title_ar") @db.VarChar(300)
  titleEn        String   @map("title_en") @db.VarChar(300)
  category       String   @db.VarChar(100) // Emergency, Internal Medicine, Surgery, Pediatrics, ICU...
  minRequired    Int      @default(5) @map("min_required")
  descriptionAr  String?  @map("description_ar") @db.Text
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  caseLogs    ClinicalCaseLog[]
  competencies CompetencyProgress[]

  @@map("procedure_catalogs")
}

/// سجل الحالة والحالة السريرية للمتدرب (Clinical Case & Procedure Log)
model ClinicalCaseLog {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  traineeProfileId String    @map("trainee_profile_id") @db.Uuid
  trainerProfileId String?   @map("trainer_profile_id") @db.Uuid
  rotationId       String?   @map("rotation_id") @db.Uuid
  departmentId     String?   @map("department_id") @db.Uuid
  procedureId      String?   @map("procedure_id") @db.Uuid
  
  // Case details
  diagnosis        String    @db.VarChar(300)
  patientAge       Int?      @map("patient_age")
  patientGender    String?   @map("patient_gender") @db.VarChar(20)
  specialtyAr      String?   @map("specialty_ar") @db.VarChar(200)
  complexity       String    @default("medium") @db.VarChar(20) // low, medium, high, critical
  
  // Level of participation: observation, assisted, performed, performed_independently
  participationLevel String  @default("performed") @map("participation_level") @db.VarChar(50)
  notes            String?   @db.Text
  evidenceUrls     String[]  @default([]) @map("evidence_urls")
  
  // Workflow: draft -> submitted -> trainer_approved -> academic_approved -> completed
  status           String    @default("submitted") @db.VarChar(30)
  
  performedAt      DateTime  @default(now()) @map("performed_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organization   Organization     @relation(fields: [organizationId], references: [id])
  traineeProfile TraineeProfile   @relation(fields: [traineeProfileId], references: [id])
  trainerProfile TrainerProfile?  @relation(fields: [trainerProfileId], references: [id])
  rotation       Rotation?        @relation(fields: [rotationId], references: [id])
  department     Department?      @relation(fields: [departmentId], references: [id])
  procedure      ProcedureCatalog? @relation(fields: [procedureId], references: [id])
  signoffs       LogbookSignoff[]

  @@index([traineeProfileId])
  @@index([organizationId])
  @@map("clinical_case_logs")
}

/// كفاءات المتدرب ومتابعة التقدم بالمهارات (Competency Tracking)
model CompetencyProgress {
  id               String   @id @default(uuid()) @db.Uuid
  traineeProfileId String   @map("trainee_profile_id") @db.Uuid
  procedureId      String   @map("procedure_id") @db.Uuid
  requiredCount    Int      @default(5) @map("required_count")
  completedCount   Int      @default(0) @map("completed_count")
  status           String   @default("pending") @db.VarChar(20) // pending, in_progress, completed
  lastUpdated      DateTime @default(now()) @map("last_updated") @db.Timestamptz

  traineeProfile TraineeProfile   @relation(fields: [traineeProfileId], references: [id])
  procedure      ProcedureCatalog @relation(fields: [procedureId], references: [id])

  @@unique([traineeProfileId, procedureId])
  @@map("competency_progress")
}

/// التوقيع والاعتماد الرقمي للحالة / السجل (Digital Sign-off)
model LogbookSignoff {
  id             String   @id @default(uuid()) @db.Uuid
  caseLogId      String   @map("case_log_id") @db.Uuid
  signerId       String   @map("signer_id") @db.Uuid
  signerRole     String   @map("signer_role") @db.VarChar(30) // trainer, academic_supervisor
  signatureUrl   String?  @map("signature_url") @db.VarChar(500)
  feedback       String?  @db.Text
  signedAt       DateTime @default(now()) @map("signed_at") @db.Timestamptz

  caseLog ClinicalCaseLog @relation(fields: [caseLogId], references: [id], onDelete: Cascade)
  signer  UserAccount     @relation(fields: [signerId], references: [id])

  @@map("logbook_signoffs")
}

// ============================================================================
// 21. TRAINER LEAVE & REASSIGNMENT
// ============================================================================

/// إجازات المدربين وتغطياتهم — لضمان استمرار تدريب المتدربين دون انقطاع
model TrainerLeave {
  id                   String    @id @default(uuid()) @db.Uuid
  trainerProfileId     String    @map("trainer_profile_id") @db.Uuid
  organizationId       String    @map("organization_id") @db.Uuid
  /// annual_leave | emergency_leave | sick_leave | maternity_leave
  /// training_course | conference | temporary_assignment
  /// transfer | retirement | resignation
  leaveType            String    @map("leave_type") @db.VarChar(30)
  startDate            DateTime  @map("start_date") @db.Date
  endDate              DateTime  @map("end_date") @db.Date
  /// pending | approved | active | completed | cancelled
  status               String    @default("pending") @db.VarChar(20)
  reason               String?   @db.Text
  replacementTrainerId String?   @map("replacement_trainer_id") @db.Uuid
  autoReassigned       Boolean   @default(false) @map("auto_reassigned")
  approvedById         String?   @map("approved_by") @db.Uuid
  approvedAt           DateTime? @map("approved_at") @db.Timestamptz
  createdById          String?   @map("created_by") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  trainerProfile     TrainerProfile  @relation("TrainerLeaves", fields: [trainerProfileId], references: [id])
  replacementTrainer TrainerProfile? @relation("ReplacementLeaves", fields: [replacementTrainerId], references: [id])
  organization       Organization    @relation(fields: [organizationId], references: [id])
  reassignments      TrainerReassignment[]

  @@index([trainerProfileId, status])
  @@index([organizationId, startDate])
  @@map("trainer_leaves")
}

/// سجل إعادة الإسناد — immutable audit trail لنقل المتدربين بين المدربين
model TrainerReassignment {
  id                    String    @id @default(uuid()) @db.Uuid
  organizationId        String    @map("organization_id") @db.Uuid
  /// single | multiple | entire_trainer | entire_department
  reassignmentType      String    @map("reassignment_type") @db.VarChar(30)
  /// annual_leave | emergency_leave | sick_leave | maternity_leave
  /// training_course | conference | temporary_assignment | transfer
  /// retirement | resignation | capacity_overflow | department_closure
  /// administrative_decision
  reason                String    @db.VarChar(50)
  previousTrainerId     String    @map("previous_trainer_id") @db.Uuid
  newTrainerId          String    @map("new_trainer_id") @db.Uuid
  departmentId          String    @map("department_id") @db.Uuid
  trainerLeaveId        String?   @map("trainer_leave_id") @db.Uuid
  effectiveDate         DateTime  @map("effective_date") @db.Timestamptz
  previousAssignmentEnd DateTime? @map("previous_assignment_end") @db.Timestamptz
  notes                 String?   @db.Text
  approvedById          String?   @map("approved_by") @db.Uuid
  createdById           String    @map("created_by") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz

  organization    Organization        @relation(fields: [organizationId], references: [id])
  previousTrainer TrainerProfile      @relation("ReassignmentFrom", fields: [previousTrainerId], references: [id])
  newTrainer      TrainerProfile      @relation("ReassignmentTo", fields: [newTrainerId], references: [id])
  department      Department          @relation(fields: [departmentId], references: [id])
  trainerLeave    TrainerLeave?       @relation(fields: [trainerLeaveId], references: [id])
  trainees        TrainerReassignmentTrainee[]

  @@index([organizationId, createdAt])
  @@index([previousTrainerId])
  @@index([newTrainerId])
  @@map("trainer_reassignments")
}

/// تفصيل المتدربين المنقولين في كل عملية إعادة إسناد
model TrainerReassignmentTrainee {
  id                String @id @default(uuid()) @db.Uuid
  reassignmentId    String @map("reassignment_id") @db.Uuid
  traineeProfileId  String @map("trainee_profile_id") @db.Uuid
  rotationId        String @map("rotation_id") @db.Uuid
  previousTrainerId String @map("previous_trainer_id") @db.Uuid
  newTrainerId      String @map("new_trainer_id") @db.Uuid

  reassignment   TrainerReassignment @relation(fields: [reassignmentId], references: [id], onDelete: Cascade)
  traineeProfile TraineeProfile      @relation(fields: [traineeProfileId], references: [id])
  rotation       Rotation            @relation(fields: [rotationId], references: [id])

  @@index([reassignmentId])
  @@map("trainer_reassignment_trainees")
}

