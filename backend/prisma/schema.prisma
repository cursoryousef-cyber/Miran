  maxTrainees      Int?     @map("max_trainees")
  isActive         Boolean  @default(true) @map("is_active")
  createdById      String?  @map("created_by") @db.Uuid
  updatedById      String?  @map("updated_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  trainerProfile TrainerProfile @relation(fields: [trainerProfileId], references: [id], onDelete: Cascade)
  program        Program        @relation(fields: [programId], references: [id])

  @@unique([trainerProfileId, programId])
  @@index([programId])
  @@map("trainer_programs")
}

