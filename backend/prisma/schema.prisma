  assignedHospitalId          String?   @map("assigned_hospital_id") @db.Uuid
  assignedDepartmentId        String?   @map("assigned_department_id") @db.Uuid
  assignedTrainerProfileId    String?   @map("assigned_trainer_profile_id") @db.Uuid
