  @@index([workflowInstanceId])
  @@map("workflow_actions")
}

// ============================================================================
// 6. OUTBOX / EVENT BUS — reliable event delivery
// ============================================================================

/// Transactional Outbox — guarantees events are published exactly once
model OutboxEvent {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  eventType      String    @map("event_type") @db.VarChar(100) // 'trainee.approved', 'card.issued', etc.
  aggregateType  String    @map("aggregate_type") @db.VarChar(100) // 'trainee', 'organization', 'rotation'
  aggregateId    String    @map("aggregate_id") @db.Uuid
  payload        Json      @db.JsonB
  status         String    @default("pending") @db.VarChar(20) // 'pending', 'processing', 'published', 'failed'
  retryCount     Int       @default(0) @map("retry_count")
  maxRetries     Int       @default(5) @map("max_retries")
  lastError      String?   @map("last_error") @db.Text
  scheduledAt    DateTime  @default(now()) @map("scheduled_at") @db.Timestamptz
  processedAt    DateTime? @map("processed_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([status, scheduledAt])
  @@index([eventType])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

